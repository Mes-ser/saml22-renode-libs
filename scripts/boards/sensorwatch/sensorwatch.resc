:name: Sensor Watch SAML22


include @platform/saml22/saml22_includes.resc

include @peripherals/Mocks/DriverTest.cs

mach create "sensor-watch"
machine LoadPlatformDescription $ORIGIN/sensorwatch.repl

sysbus LoadELF $ORIGIN/watch.elf

macro reset
"""
    sysbus.cpu VectorTableOffset 0x2000
"""

# sysbus LogPeripheralAccess sysbus.nvmctrl true

start
